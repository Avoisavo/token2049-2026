# Copy to .env.local (gitignored) for the real x402 buy flow on Cardano Preprod.

# Blockfrost project id for Preprod (https://blockfrost.io)
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXX

# Buyer wallet: 24-word mnemonic. Fund it with tADA (https://docs.cardano.org/cardano-testnets/tools/faucet/)
# and tUSDM (https://tusdm.moneta.global). Never commit this.
FRESHPROOF_BUYER_MNEMONIC=

# Seller's Preprod address that receives USDM on approved deliveries
FRESHPROOF_SELLER_ADDRESS=addr_test1...

# Optional
# FRESHPROOF_MARKET_URL=http://localhost:4021
# FRESHPROOF_FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
