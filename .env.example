# Copy the names you need into .env.local (git-ignored, chmod 600).
# `npm run wallets` creates BUYER_MNEMONIC and SPECIALIST_MNEMONIC for you.
# Values already set in the process environment win over .env.local.

# --- Chain access (https://blockfrost.io, project network: Cardano preprod) ---
BLOCKFROST_API_KEY_PREPROD=

# --- Claude (writes the brief) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Test wallets (created by `npm run wallets`; never commit) ---
BUYER_MNEMONIC=
SPECIALIST_MNEMONIC=

# --- Specialist data agent (x402 seller) ---
# SPECIALIST_PORT=4021
# SPECIALIST_URL=http://127.0.0.1:4021
# SPECIALIST_PRICE_UNITS=100000          # 0.10 test USDM per query
# FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
# X402_MAX_PAYMENT_UNITS=250000          # buyer refuses to sign above 0.25 tUSDM

# --- Sokosumi Coworker (worker) ---
COWORKER_ID=
# Leave both empty for the Personal Workspace. For the TOKEN2049 event Workspace:
# SOKOSUMI_ORGANIZATION_ID=01a109d1-32a9-71a3-a0e3-658b2a7987cd
# SOKOSUMI_ORGANIZATION_SLUG=token2049-origins-hackathon-2026-nws2r7

# --- Masumi Payment Service (paid Tasks) ---
# MPS_URL=http://127.0.0.1:3012
MPS_RUNTIME_TOKEN=
PAID_TASKS_ENABLED=false
